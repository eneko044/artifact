index e91564c..2bf823e 100644
--- a/src/i_input.c
+++ b/src/i_input.c
@@ -466,3 +466,59 @@ void I_BindInputVariables(void)
     M_BindIntVariable("vanilla_keyboard_mapping",  &vanilla_keyboard_mapping);
     M_BindIntVariable("novert",                    &novert);
 }
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+// Entry points for the web page: the on-screen touch controls feed the
+// same event queue as the physical keyboard and mouse.
+
+EMSCRIPTEN_KEEPALIVE void web_key(int down, int key)
+{
+    event_t event = {0};
+
+    event.type = down ? ev_keydown : ev_keyup;
+    event.data1 = key;
+    if (down)
+    {
+        event.data2 = key;
+        event.data3 = key < 128 ? key : 0;
+    }
+    D_PostEvent(&event);
+}
+
+EMSCRIPTEN_KEEPALIVE void web_mouse_button(int button, int on)
+{
+    event_t event = {0};
+
+    if (on)
+    {
+        mouse_button_state |= (1 << button);
+    }
+    else
+    {
+        mouse_button_state &= ~(1 << button);
+    }
+
+    event.type = ev_mouse;
+    event.data1 = mouse_button_state;
+    D_PostEvent(&event);
+}
+
+EMSCRIPTEN_KEEPALIVE void web_mouse_move(int dx, int dy)
+{
+    event_t event = {0};
+
+    event.type = ev_mouse;
+    event.data1 = mouse_button_state;
+    event.data2 = dx;
+    event.data3 = dy;
+    D_PostEvent(&event);
+}
+
+EMSCRIPTEN_KEEPALIVE void web_save_settings(void)
+{
+    M_SaveDefaults();
+    EM_ASM({ if (Module.onPersist) Module.onPersist(); });
+}
+#endif
