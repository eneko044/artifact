+// Lets the web page leave the game cleanly (settings saved, audio closed).
+EMSCRIPTEN_KEEPALIVE void web_quit(void)
+{
+    web_quit_requested = true;
+}
+
+// Bit flags describing what is on screen, polled by the web page:
+// 1 menu open, 2 playing a level, 4 automap, 8 paused, 16 demo, 32 player dead.
+EMSCRIPTEN_KEEPALIVE int web_state(void)
+{
+    int state = 0;
+
+    if (menuactive) state |= 1;
+    if (gamestate == GS_LEVEL) state |= 2;
+    if (automapactive) state |= 4;
+    if (paused) state |= 8;
+    if (demoplayback) state |= 16;
+    if (gamestate == GS_LEVEL && players[consoleplayer].playerstate == PST_DEAD) state |= 32;
+    return state;
+}
